# 依赖
node_modules/

# 本地数据库（不入库；GitHub Actions 用 cache 保存它以便增量抓取）
data/*.db
data/*.db-wal
data/*.db-shm

# 运行设置（本机个人配置，不入库）
config/settings.json

# VAPID 私钥（Web Push 推送密钥，绝不能入库）
config/.vapid.json

# Worker 本地开发密钥与构建产物
worker/.dev.vars
worker/.wrangler/
worker/dist/
worker/node_modules/

# App：构建产物与签名密钥
# www/ 由 app/build.mjs 生成，CI 会重新构建，不入库
app/www/
# 签名密钥绝不能入库；CI 在构建时临时生成
app/android/keystore/
app/android/app/build/
app/android/build/
app/android/.gradle/
app/android/local.properties
app/android/app/src/main/assets/public/
app/android/app/src/main/assets/capacitor.config.json
app/android/app/src/main/assets/capacitor.plugins.json
app/android/capacitor-cordova-android-plugins/

# 视觉工具产物
.dsh-vision-router/

# 系统与日志
.DS_Store
Thumbs.db
npm-debug.log*
*.log
