# 依赖
node_modules/

# 本地数据库（不入库；GitHub Actions 用 cache 保存它以便增量抓取）
data/*.db
data/*.db-wal
data/*.db-shm

# 运行设置（本机个人配置，不入库）
config/settings.json

# VAPID 私钥（Web Push 推送密钥，绝不能入库）
config/.vapid.json

# Worker 本地开发密钥与构建产物
worker/.dev.vars
worker/.wrangler/
worker/dist/
worker/node_modules/

# 视觉工具产物
.dsh-vision-router/

# 系统与日志
.DS_Store
Thumbs.db
npm-debug.log*
*.log
