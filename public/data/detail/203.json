000pt;} span.10{ font-family:'Times New Roman';} p.MsoFooter{ mso-style-name:页脚; margin:0pt; margin-bottom:.0001pt; tab-stops:center blank 207.6500pt right blank 415.3000pt ; vsb_temp-mode:char; mso-pagination:none; text-align:left; font-family:Calibri; mso-fareast-font-family:宋体; mso-bidi-font-family:'Times New Roman'; font-size:9.0000pt; mso-font-kerning:1.0000pt;} p.MsoHeader{ mso-style-name:页眉; margin:0pt; margin-bottom:.0001pt; border-top:none; mso-border-top-alt:none; border-right:none; mso-border-right-alt:none; border-bottom:none; mso-border-bottom-alt:none; border-left:none; mso-border-left-alt:none; padding:1pt 4pt 1pt 4pt ; tab-stops:center blank 207.6500pt right blank 415.3000pt ; vsb_temp-mode:char; mso-pagination:none; text-align:justify; text-justify:inter-ideograph; font-family:Calibri; mso-fareast-font-family:宋体; mso-bidi-font-family:'Times New Roman'; font-size:9.0000pt; mso-font-kerning:1.0000pt;} span.msoIns{ mso-style-type:export-only; mso-style-name:\"\"; text-decoration:underline; text-underline:single; color:blue;} span.msoDel{ mso-style-type:export-only; mso-style-name:\"\"; text-decoration:line-through; color:red;} table.MsoNormalTable{ mso-style-name:普通表格; mso-style-parent:\"\"; mso-style-noshow:yes; mso-tstyle-rowband-size:0; mso-tstyle-colband-size:0; mso-padding-alt:0.0000pt 5.4000pt 0.0000pt 5.4000pt; mso-para-margin:0pt; mso-para-margin-bottom:.0001pt; mso-pagination:widow-orphan; font-family:'Times New Roman'; font-size:10.0000pt; mso-ansi-language:#0400; mso-fareast-language:#0400; mso-bidi-language:#0400;} @page{mso-page-border-surround-header:no; mso-page-border-surround-footer:no;}@page Section0{ margin-top:72.0000pt; margin-bottom:72.0000pt; margin-left:90.0000pt; margin-right:90.0000pt; size:595.3000pt 841.9000pt; vsb_temp:15.6000pt; mso-header-margin:42.5500pt; mso-footer-margin:49.6000pt;} div.Section0{page:Section0;}</style><div><p>为深入学习贯彻习近平新时代中国特色社会主义思想，积极响应党的二十大报告中“教育、科技、人才是全面建设社会主义现代化国家的基础性、战略性支撑”的重要部署，中北大学新思想青年说宣讲团成员刘杰，以“重温经典，云端筑梦”为核心主题，在红色研学、社区宣讲、云端支教的三维实践版图中步履不停。他用脚步丈量初心，用行动传递力量，在理论与实践的融合中书写当代青年的责任担当，让我们一同走进他的实践故事！<br></p><p><img src=\"/virtual_attach_file.vsb?afc=Xnl7/8oRf7ollsMKlWRL8rVUm78LmvODnlV2MRCDMNQVL4N0gihFp2hmCIa0nSyZMYhfnkhfUmf7Mm7anzMVLlCPUmAkMNQkLz-ZM8UsMRWFn7WVU4-ZnzQFnRQfLkbaptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/E87ADAB0D610E3E1F1B8B6FB1287D742/DBEC28E6/D6A0\" vheight=\"308\" vwidth=\"503\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=Xnl7/8oRf7ollsMKlWRL8rVUm78LmvODnlV2MRCDMNQVL4N0gihFp2hmCIa0nSyZMYhfnkhfUmf7Mm7anzMVLlCPUmAkMNQkLz-ZM8UsMRWFn7WVU4-ZnzQFnRQfLkbaptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\"><img src=\"/virtual_attach_file.vsb?afc=XozL/bnNV7nN-YUKzfVUNQ2oz-8U4VOkLlQ7nNlDU8CbMlC0gihFp2hmCIa0LShknShfMSyaMlrRUlnVU8C8ozv4MzVRUNCYUNLbM4GaolVFL4vPnlLiolQFLzGaMlLJv2bjo4OeoDMOqsAbQDMZ_ShXptQ0g47YL4v0LzvYMR9Jqdxnx&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/1BEA505ECADECF497351CBF2BC97009A/371EC59F/1005C\" vheight=\"\" vwidth=\" 503px\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XozL/bnNV7nN-YUKzfVUNQ2oz-8U4VOkLlQ7nNlDU8CbMlC0gihFp2hmCIa0LShknShfMSyaMlrRUlnVU8C8ozv4MzVRUNCYUNLbM4GaolVFL4vPnlLiolQFLzGaMlLJv2bjo4OeoDMOqsAbQDMZ_ShXptQ0g47YL4v0LzvYMR9Jqdxnx&oid=1073042095&tid=1237&nid=17248&e=.png\">&nbsp;</p><p><strong>三维发力：把初心刻进实践足迹</strong><strong></strong></p><p><strong>踏寻足迹，筑牢信仰</strong>：刘杰随实践团走进5处红色教育基地，以“实地感悟+历史溯源”沉浸式研学。于八路军驻晋办事处体悟报国担当，在国民师范旧址读懂“思想建党”初心，从太原解放纪念碑汲取斗争力量，在刘胡兰纪念馆接受信仰洗礼，在集宁战役纪念馆领悟民族团结内涵。革命精神于寻访中内化于心、外化于行。</p><p><img src=\"/virtual_attach_file.vsb?afc=Xnln/VU8VRLl-DMKmrVnlUYozrRUzAORMl7DnmCanmvYLz-0gihFp2hmCIa0MYyanSysMkyZnRfRU4LaLlL8M8MkUmTRLRGYUmffnRUan7QFL4vsLmMkL4QFLlQfL7CJv2bjo4OeoDMOqsAbQDMZ_ShXptQ0g47YL4v0LzvYMR9Jqdxnx&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/70E748D0CC301C47CBB9C002B0AD40DF/37723B36/1FA0F\" vheight=\"195\" vwidth=\"264\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=Xnln/VU8VRLl-DMKmrVnlUYozrRUzAORMl7DnmCanmvYLz-0gihFp2hmCIa0MYyanSysMkyZnRfRU4LaLlL8M8MkUmTRLRGYUmffnRUan7QFL4vsLmMkL4QFLlQfL7CJv2bjo4OeoDMOqsAbQDMZ_ShXptQ0g47YL4v0LzvYMR9Jqdxnx&oid=1073042095&tid=1237&nid=17248&e=.png\"><img src=\"/virtual_attach_file.vsb?afc=XMm6/fLlCZLzL8UKmCaozl8MR7inRNOiUlU4nml8UlCPUNC0gihFp2hmCIa0UYyiLShkM1y4ozN4L7-PM7C4M49snN7DMmTkM87PL4-iM8rFM77YnmMkMmrFLl-ZUmlJv2bjo4OeoDMOqsAbQDMZ_ShXptQ0g47YL4v0LzvYMR9Jqdxnx&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/C51B639930B14F3787FA669B7A13257E/4A2F3B65/1B8B5\" vheight=\"195\" vwidth=\"260\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XMm6/fLlCZLzL8UKmCaozl8MR7inRNOiUlU4nml8UlCPUNC0gihFp2hmCIa0UYyiLShkM1y4ozN4L7-PM7C4M49snN7DMmTkM87PL4-iM8rFM77YnmMkMmrFLl-ZUmlJv2bjo4OeoDMOqsAbQDMZ_ShXptQ0g47YL4v0LzvYMR9Jqdxnx&oid=1073042095&tid=1237&nid=17248&e=.png\">&nbsp;</p><p><strong>传递新思，凝聚共识</strong>：团队以“青年视角+群众语言”深耕基层，在太原社区串联历史与新貌，阐释核心理念；集宁新城社区宣讲获《乌兰察布日报》报道；吕梁文水创新“宣讲+服务”模式，慰问退伍残疾军人，让红色精神扎根基层。</p><p><img src=\"/virtual_attach_file.vsb?afc=XLRr/kU4lPMzT2MKRnfLz7YLlQko7MOVLz-bUm-DL4Uin7L0gihFp2hmCIa0okyaUShRokyYUzTVnmlsL47YUzCbMzM7U8CZMRUiLRvaL4fFU47ZLzv8LlnFMm94nkbaptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/80AC82A9EF57312A6953DCF844507030/C181741D/683D\" vheight=\"128\" vwidth=\"172\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XLRr/kU4lPMzT2MKRnfLz7YLlQko7MOVLz-bUm-DL4Uin7L0gihFp2hmCIa0okyaUShRokyYUzTVnmlsL47YUzCbMzM7U8CZMRUiLRvaL4fFU47ZLzv8LlnFMm94nkbaptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\"><img src=\"/virtual_attach_file.vsb?afc=XLmW/fUmv8ol7ZLKmWfM49anmM7LllODLmGPLllYMRW7Uz-0gihFp2hmCIa0UYy8USh7LSyinNlDnmrVLRlsolCsolLaoRfkM8U4Lz7bM8MFLRLsL7V7Lm6FM7liokbaptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/C4AD15FE6F5E0579F79C080B7D31197C/0370AD27/4E58\" vheight=\"129\" vwidth=\"172\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XLmW/fUmv8ol7ZLKmWfM49anmM7LllODLmGPLllYMRW7Uz-0gihFp2hmCIa0UYy8USh7LSyinNlDnmrVLRlsolCsolLaoRfkM8U4Lz7bM8MFLRLsL7V7Lm6FM7liokbaptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\"><img src=\"/virtual_attach_file.vsb?afc=XL7n/2ozCsoRAVLKNC8nRCbozA7U8UOZoR62nm62U4f2L4v0gihFp2hmCIa0UYysLSh7okyYL7-snzlPL4vDMl78L8UaoRAfnmlYU8nkoRfFLmC4U8LbM4WFM4UsU1baptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/C71D820B7E513765A43D088AF52CDB80/263CC972/747B\" vheight=\"128\" vwidth=\"170\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XL7n/2ozCsoRAVLKNC8nRCbozA7U8UOZoR62nm62U4f2L4v0gihFp2hmCIa0UYysLSh7okyYL7-snzlPL4vDMl78L8UaoRAfnmlYU8nkoRfFLmC4U8LbM4WFM4UsU1baptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\">&nbsp;</p><p><strong>赋能青春，助力强国</strong>：紧扣教育强国部署，刘杰以“美育筑基、科技启智、全面发展”开展云端支教，通过直播授课、一对一辅导、体育打卡监督，实现“德智体美劳”全覆盖。累计服务20余名青少年，完成80余课时，作业与打卡率达95%，部分作品入选社区文化展。</p><p><img src=\"/virtual_attach_file.vsb?afc=XLNV/2nzCbU4G8MKRnRM4laLmlPnlLODLR-aL4-iollsMRG0gihFp2hmCIa0L1yioSyZn1h7UmUinm7Pnz74oz94UzlanlU4LmAkUlMRn7nFLzVVLRvYLmnFMzM7LR7Jv2bjo4OeoDMOqsAbQDMZ_ShXptQ0g47YL4v0LzvYMR9Jqdxnx&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/2598FDB45F11E13983A50ED328BACCDD/11E07224/53D01\" vheight=\"220\" vwidth=\"296\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XLNV/2nzCbU4G8MKRnRM4laLmlPnlLODLR-aL4-iollsMRG0gihFp2hmCIa0L1yioSyZn1h7UmUinm7Pnz74oz94UzlanlU4LmAkUlMRn7nFLzVVLRvYLmnFMzM7LR7Jv2bjo4OeoDMOqsAbQDMZ_ShXptQ0g47YL4v0LzvYMR9Jqdxnx&oid=1073042095&tid=1237&nid=17248&e=.png\">&nbsp;<img src=\"/virtual_attach_file.vsb?afc=XUmL/iLR-YMlUioKlLbMlUPL8lsM4GODUmfRM7Qkol-Pn770gihFp2hmCIa0okyankyPLYh7MRvsU87iLR9DL4WfLRM7o7CPnNnRM49inz6FLlLaLNUYUNQFUl-Dnkbaptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/80D13D477CA508632A03D8F1FDC785E7/1C02D2BF/AB6D\" vheight=\"222\" vwidth=\"222\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XUmL/iLR-YMlUioKlLbMlUPL8lsM4GODUmfRM7Qkol-Pn770gihFp2hmCIa0okyankyPLYh7MRvsU87iLR9DL4WfLRM7o7CPnNnRM49inz6FLlLaLNUYUNQFUl-Dnkbaptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\"></p><p><strong>成果斐然：媒体点赞，行动有声</strong><strong></strong></p><p>实践成效获多方认可：集宁新城社区宣讲被《乌兰察布日报》报道，吕梁文水志愿活动登上中国青年网，云支教中青少年的成长蜕变，成为实践路上最温暖的注脚。</p><p><strong>实践感悟：以行践知，坚定方向</strong><strong></strong></p><p>此次实践构建“理论学习-实践锻炼-思想升华”闭环，将理论转化为行动，形成青年社会实践可复制模式，更让刘杰坚定“以青春之我、担时代之责”的成长方向。</p><p><img src=\"/virtual_attach_file.vsb?afc=XozL/PLzGYM4fVnKml4MmfRol-bU4-OsM462Uz9ZL4-bM490gihFp2hmCIa0n1h7oSyYoSybLzvZMRvbM49YUmUsnmTkMlUaL4-bnl-4nzMFo77aMlVRL4QFU8Vfn1baptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/FD9299178479782B47F9B5D0329EB3E3/8A05AC36/CAAF\" vheight=\"202\" vwidth=\"257\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XozL/PLzGYM4fVnKml4MmfRol-bU4-OsM462Uz9ZL4-bM490gihFp2hmCIa0n1h7oSyYoSybLzvZMRvbM49YUmUsnmTkMlUaL4-bnl-4nzMFo77aMlVRL4QFU8Vfn1baptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\"><img src=\"/virtual_attach_file.vsb?afc=XM4A/kMzGbLmCaUKN-4nmn7nmG4nRMO7MNlsUNC8oRf7Umv0gihFp2hmCIa0MYyYMkyZU1h7Lm9Zn778L4GDUzLiU4vbU8VRozGaLRM7L7QFnzC4M8QVUlrFUz-aU1baptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\" vsbhref=\"vurl\" vurl=\"/_vsl/7248BD288DA4306A35C79CAC90003D0F/E637FEAE/A20B\" vheight=\"202\" vwidth=\"287\" alt=\"\" orisrc=\"/virtual_attach_file.vsb?afc=XM4A/kMzGbLmCaUKN-4nmn7nmG4nRMO7MNlsUNC8oRf7Umv0gihFp2hmCIa0MYyYMkyZU1h7Lm9Zn778L4GDUzLiU4vbU8VRozGaLRM7L7QFnzC4M8QVUlrFUz-aU1baptveo4OeCDPK_dTjCsAbgDTJQty0Lz-4MYyPM4-8okbw62x8c&oid=1073042095&tid=1237&nid=17248&e=.png\">&nbsp;</p></div></div></div>","bodyText":