:{&quot;ascii&quot;:&quot;楷体&quot;,&quot;hAnsi&quot;:&quot;楷体&quot;,&quot;eastAsia&quot;:&quot;楷体&quot;},&quot;sz&quot;:{&quot;val&quot;:240},&quot;rStyle&quot;:{},&quot;author&quot;:&quot;p.144115233183346562&quot;},&quot;mode&quot;:1,&quot;preventFormatTrackChanges&quot;:false},&quot;propertyType&quot;:&quot;RunProperty&quot;,&quot;builtinStyleName&quot;:&quot;&quot;},{&quot;operationType&quot;:&quot;InsertText&quot;,&quot;param&quot;:{&quot;text&quot;:&quot;\\r&quot;,&quot;range&quot;:{&quot;gcpBegin&quot;:282,&quot;len&quot;:0},&quot;preventTextTrackChanges&quot;:false},&quot;builtinStyleName&quot;:&quot;&quot;},{&quot;operationType&quot;:&quot;ModifyRunProp&quot;,&quot;param&quot;:{&quot;range&quot;:{&quot;gcpBegin&quot;:282,&quot;len&quot;:1},&quot;property&quot;:{&quot;rFonts&quot;:{&quot;hint&quot;:2,&quot;ascii&quot;:&quot;楷体&quot;,&quot;hAnsi&quot;:&quot;楷体&quot;,&quot;eastAsia&quot;:&quot;楷体&quot;},&quot;isPlaceholder&quot;:true,&quot;author&quot;:&quot;p.144115233183346562&quot;,&quot;rStyle&quot;:{}},&quot;mode&quot;:1,&quot;preventFormatTrackChanges&quot;:false},&quot;propertyType&quot;:&quot;RunProperty&quot;,&quot;builtinStyleName&quot;:&quot;&quot;},{&quot;operationType&quot;:&quot;ModifyParagraphProp&quot;,&quot;param&quot;:{&quot;range&quot;:{&quot;gcpBegin&quot;:282,&quot;len&quot;:1},&quot;property&quot;:{&quot;spacing&quot;:{&quot;line&quot;:240,&quot;lineRule&quot;:1},&quot;ind&quot;:{&quot;firstLine&quot;:480},&quot;numPr&quot;:{},&quot;pStyle&quot;:{}},&quot;mode&quot;:1,&quot;preventFormatTrackChanges&quot;:false},&quot;propertyType&quot;:&quot;ParagraphProperty&quot;,&quot;builtinStyleName&quot;:&quot;&quot;}],&quot;subStory&quot;:[],&quot;srcGlobalPadId&quot;:&quot;72dd998f-7e43-5258-8ea3-9accd6198cdb&quot;,&quot;copyStart&quot;:1253}\" data-version=\"3.0.0\" inner_data_type=\"localData\" data-hash=\"8caab7231970b2407903a6eb34b6d076\"></div><div><div><p>青春寄语</p><p>志愿路上步履不停，她用热忱书写奉献篇章；校园舞台活力绽放，她用协作诠释青春担当；科创赛道锐意突破，她用实力铸就逐梦荣光。她以知行合一的坚守，在服务他人中传递温暖；以跨界突围的勇气，在竞赛比拼中淬炼锋芒；以全面发展的姿态，勾勒出当代青年最昂扬的模样。愿她此后心怀炽热、眼有星光，在更广阔的天地里奔赴山海，绽放独属于自己的璀璨芳华。</p><p>栏目简介</p><p>《青春榜样志》聚焦于计算机科学与技术学院涌现出的优秀青年学子，记录他们在学业深耕、科研创新与实践奉献中留下的坚实足迹，展现新时代大学生将个人理想锚定时代需求、勇担使命的昂扬风貌，以榜样之光，照亮更多青年的逐梦航向。</p></div></div><p><br></p></div><BR><BR></DIV>","bodyText":"","attachments":[],"image":"http://cst.nuc.edu.cn/virtual_attach_file.vsb?afc=inzUDaMz7aLllsnsmf2LmN8ozL8L4vZYLRf7nz9DMmV2MR-0gihFp2hmCIa0L1yiMYyaMSy4LzfRolC4nRQRnml4MzfVMNLPLzMRM4U8nznFMRrVMNQ2nRQFL4L4nmLJv2bjo4OeoDM46khXptQ0g47PLRU0LzGsozLJqdbnx&oid=1391370217&tid=1104&nid=10793&e=.png"}